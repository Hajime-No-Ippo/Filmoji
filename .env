# Copy this file to .env and fill in secrets before running `docker compose up`
# Do NOT commit your real TMDB key or other secrets.

# TMDB API key (required)
TMDB_API_KEY=c3a2735a34e1819bd32000c9a00e4fa6

# Database credentials (optional - defaults used by compose)
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_HOST=db
DB_PORT=5432
